# ─────────────────────────────────────────────────────────────────
#  Cove configuration
#  Copy to `.env` and edit — or just run `./setup.sh`, which generates
#  the secrets for you and runs the preflight checks.
# ─────────────────────────────────────────────────────────────────

# The public URL of your site, no trailing slash.
#
# IMPORTANT: federated identities are built from this value
# (@you@this-domain). Once people have followed you it must not change,
# which is why it is the first thing the setup wizard asks for.
COVE_SITE_URL=http://localhost:8080

# ─── Host ports ──────────────────────────────────────────────────
# These are the ports on the HOST. Inside the container Caddy always listens on
# 80/443; these just map onto them.
#
# They default to unprivileged ports on purpose: rootless Podman cannot bind
# below 1024 (the kernel's net.ipv4.ip_unprivileged_port_start is 1024), so
# publishing 80 fails outright. For a real domain on the standard ports, either
# raise the floor once:
#   sudo sysctl -w net.ipv4.ip_unprivileged_port_start=80
#   # persist: echo 'net.ipv4.ip_unprivileged_port_start=80' | sudo tee /etc/sysctl.d/99-cove.conf
# ...or run the stack rootful. Then set these to 80 and 443 and update
# COVE_SITE_URL to match.
COVE_HTTP_PORT=8080
COVE_HTTPS_PORT=8443

# Your handle — the "you" in @you@your-domain.
COVE_HANDLE=me

# The address Caddy should serve. A bare hostname or https:// URL turns on
# automatic Let's Encrypt; `http://localhost` keeps it plain HTTP so a LAN
# install never blocks on certificate issuance.
COVE_SITE_ADDRESS=http://localhost

# Optional — used for ACME expiry notices when Caddy obtains certificates.
COVE_ACME_EMAIL=

# Human-readable name shown in the UI. Safe to change at any time.
COVE_SITE_NAME=Cove
COVE_SITE_TAGLINE=A quiet corner of the internet.

# ─── Postgres ────────────────────────────────────────────────────
# The bundled compose stack provides this. Point DATABASE_URL elsewhere
# if you would rather run your own Postgres.
POSTGRES_USER=cove
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cove
DATABASE_URL=postgres://cove:change-me@db:5432/cove

# ─── Secrets ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
COVE_SESSION_SECRET=
COVE_SECRET_KEY=

# ─── Media processing ────────────────────────────────────────────
# Power preset controls how much work transcoding is allowed to do:
#   remux-first  no re-encoding at all — fastest, works on a Raspberry Pi
#   low-power    single 720p rendition
#   balanced     720p + 480p  (default)
#   quality      full 1080p/720p/480p ladder
COVE_POWER_PRESET=balanced

# How many media jobs may run at once. Keep at 1 on low-power hardware.
WORKER_CONCURRENCY=1

# Where media lives inside the container. Mounted from ./data by default.
COVE_DATA_DIR=/data

# Refuse to start a job when free space drops below this (megabytes).
# A full disk mid-encode is the most common self-hosting failure.
COVE_MIN_FREE_MB=2048

# ─── Live streaming (optional, compose profile "live") ───────────
COVE_LIVE_ENABLED=false
# Set this to your public IP when running behind NAT/CGNAT, or WebRTC
# viewers cannot reach the media server.
MTX_WEBRTCADDITIONALHOSTS=

# ─── Federation (Phase 5) ────────────────────────────────────────
# Outbound only by default: your posts travel to the fediverse, but
# inbound replies stay off until you explicitly enable them.
COVE_FEDERATION_ENABLED=false
COVE_FEDERATION_ALLOW_REPLIES=false

# ─── Access ──────────────────────────────────────────────────────
# public | unlisted | password
COVE_VISIBILITY=public
